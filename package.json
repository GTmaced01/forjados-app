{
  "name": "forjados-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-vite-env.mjs && tsc -b && vite build",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check:secrets": "node scripts/check-secrets.mjs",
    "supabase:baseline:check": "node scripts/validate-supabase-baseline.mjs --metadata && node scripts/validate-supabase-baseline.mjs --dump supabase/baseline/production-schema.sql",
    "supabase:baseline:validate-dump": "node scripts/validate-supabase-baseline.mjs --dump",
    "preview": "vite preview",
    "mobile:check": "cap sync",
    "mobile:sync": "npm run build && cap sync",
    "android:env:check": "node scripts/check-android-env.mjs",
    "android:build:check": "node scripts/check-android-build.mjs",
    "android:signing:test": "node scripts/test-android-signing.mjs",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:ios": "npm run mobile:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@supabase/supabase-js": "2.105.4",
    "lucide-react": "1.16.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@eslint/js": "10.0.1",
    "@types/node": "24.12.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "10.4.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.6.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.3.5"
  }
}
